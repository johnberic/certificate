cat << 'EOF' > /etc/.monitor
#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if ! command -v mysql &> /dev/null || ! command -v vnstat &> /dev/null; then
    apt update && apt install -y default-mysql-client vnstat iproute2 procps curl
fi

service=$1
ip=$(curl -s --max-time 3 https://api.ipify.org)
[ -z "$ip" ] && ip=$(hostname -I | awk '{print $1}')

os="Linux"
distro=$(grep "PRETTY_NAME" /etc/os-release | cut -d= -f2 | tr -d '"')
cpu=$(grep "model name" /proc/cpuinfo | head -1 | cut -d ":" -f2 | xargs)
memory=$(free -m | awk 'NR==2{printf "%s/%sMB", $3,$2}')
disk=$(df -h / | awk 'NR==2{print $3 "/" $2}')
uptime=$(uptime -p | sed 's/up //')
bandwidth=$(vnstat --oneline 2>/dev/null | awk -F';' '{print $11}')
[ -z "$bandwidth" ] && bandwidth="0 KB"

# HARDCODED CONFIGS
HOST='173.225.110.100'
USER='teamkidl_demo'
PASS='jan022011'
DB='teamkidl_demo'

[ -f /root/.ports ] && . /root/.ports

# 5. PROTOCOL LOGIC (SSH)
if [[ $service == "ssh" ]]; then
    sshd=$(systemctl is-active ssh 2>/dev/null || echo "inactive")
    dropbear=$(systemctl is-active dropbear 2>/dev/null || echo "inactive")
    squid=$(systemctl is-active squid 2>/dev/null || echo "inactive")
    ssl=$(systemctl is-active stunnel4 2>/dev/null || echo "inactive")
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    total_sshd=$(ss -tnp 2>/dev/null | grep -E ":22\s" | grep -i "ESTAB" | wc -l)
    total_dropbear=$(ss -tnp 2>/dev/null | grep -E ":441\s" | grep -i "ESTAB" | wc -l)
    total_sshssl=$(ss -tnp 2>/dev/null | grep -E ":443\s" | grep -i "ESTAB" | wc -l)
    totalssh=$((total_sshd + total_dropbear + total_sshssl))
    
    mysql --connect-timeout=5 --skip-ssl -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -e "
    INSERT INTO server_list (server_ip, cpu_model, distro, memory, uptime, disk, bandwidth, os, proto, ssh_online, ssh_status, dropbear_status, ssl_status, squid_status, socket_status, ssh_port, dropbear_port, squid, socket) 
    VALUES ('$ip', '$cpu', '$distro', '$memory', '$uptime', '$disk', '$bandwidth', '$os', '$service', '$totalssh', '$sshd', '$dropbear', '$ssl', '$squid', '$socket', '${ssh_port:-22}', '${dropbear_port:-441}', '${squid_port:-3128}', '${socket_port:-80}')
    ON DUPLICATE KEY UPDATE 
    cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', ssh_online='$totalssh', ssh_status='$sshd', dropbear_status='$dropbear', ssl_status='$ssl', squid_status='$squid', socket_status='$socket', ssh_port='${ssh_port:-22}', dropbear_port='${dropbear_port:-441}', squid='${squid_port:-3128}', socket='${socket_port:-80}';"

# 6. PROTOCOL LOGIC (OPENVPN)
elif [[ $service == "openvpn" ]]; then
    tcpovpn=$(systemctl is-active openvpn@server2.service 2>/dev/null || echo "inactive")
    udpovpn=$(systemctl is-active openvpn@server.service 2>/dev/null || echo "inactive")
    udphysteria=$(systemctl is-active hysteria-server.service 2>/dev/null || echo "inactive")
    squid=$(systemctl is-active squid 2>/dev/null || echo "inactive")
    ssl=$(systemctl is-active stunnel4 2>/dev/null || echo "inactive")
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    tcpusers=$([ -f /etc/openvpn/server/tcpclient.log ] && sed -n '/^ROUTING_TABLE/p' /etc/openvpn/server/tcpclient.log | wc -l || echo 0)
    udpusers=$([ -f /etc/openvpn/server/udpclient.log ] && sed -n '/^ROUTING_TABLE/p' /etc/openvpn/server/udpclient.log | wc -l || echo 0)
    totalovpn=$((tcpusers + udpusers))
    total_hysteria=$(ss -tnp 2>/dev/null | grep -E ":5666\s" | grep -i "ESTAB" | wc -l)
    
    mysql --connect-timeout=5 --skip-ssl -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -e "
    INSERT INTO server_list (server_ip, cpu_model, distro, memory, uptime, disk, bandwidth, os, proto, tcp_status, udp_status, hysteria_status, ssl_status, squid_status, socket_status, tcpssl, udpssl, tcp, udp, hysteria_port, squid, socket, online, hysteria_online) 
    VALUES ('$ip', '$cpu', '$distro', '$memory', '$uptime', '$disk', '$bandwidth', '$os', '$service', '$tcpovpn', '$udpovpn', '$udphysteria', '$ssl', '$squid', '$socket', '${tcp_ssl_port:-443}', '${udp_ssl_port:-443}', '${tcp_port:-1194}', '${udp_port:-1194}', '${hysteria_port:-5666}', '${squid_port:-3128}', '${socket_port:-80}', '$totalovpn', '$total_hysteria')
    ON DUPLICATE KEY UPDATE 
    cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', tcp_status='$tcpovpn', udp_status='$udpovpn', hysteria_status='$udphysteria', ssl_status='$ssl', squid_status='$squid', socket_status='$socket', tcpssl='${tcp_ssl_port:-443}', udpssl='${udp_ssl_port:-443}', tcp='${tcp_port:-1194}', udp='${udp_port:-1194}', hysteria_port='${hysteria_port:-5666}', squid='${squid_port:-3128}', socket='${socket_port:-80}', online='$totalovpn', hysteria_online='$total_hysteria';"

# 7. PROTOCOL LOGIC (HYSTERIA)
elif [[ $service == "hysteria" ]]; then
    udphysteria=$(systemctl is-active hysteria-server.service 2>/dev/null || echo "inactive")
    total_hysteria=$(ss -tnp 2>/dev/null | grep -E ":5666\s" | grep -i "ESTAB" | wc -l)
    
    mysql --connect-timeout=5 --skip-ssl -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -e "
    INSERT INTO server_list (server_ip, cpu_model, distro, memory, uptime, disk, bandwidth, os, proto, hysteria_status, hysteria_port, hysteria_online) 
    VALUES ('$ip', '$cpu', '$distro', '$memory', '$uptime', '$disk', '$bandwidth', '$os', '$service', '$udphysteria', '${hysteria_port:-5666}', '$total_hysteria')
    ON DUPLICATE KEY UPDATE 
    cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', hysteria_status='$udphysteria', hysteria_port='${hysteria_port:-5666}', hysteria_online='$total_hysteria';"

# 8. ALL-IN-ONE (AIO) LOGIC
elif [[ $service == "aio" ]]; then
    bash /etc/.monitor ssh
    bash /etc/.monitor openvpn
    bash /etc/.monitor hysteria
    echo "AIO Sync Complete & Saved to Database."

elif [[ $service == "reboot" ]]; then
    reboot
fi
EOF
