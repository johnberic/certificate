#!/bin/bash

service=$1
ip=$(curl -s https://api.ipify.org || hostname -I | awk '{print $1}')
os="$(neofetch os)";         os="${os##*: }"
distro="$(neofetch distro)";   distro="${distro##*: }"
cpu="$(neofetch cpu --cpu_speed on --cpu_cores off)"; cpu="${cpu##*: }"
memory="$(neofetch memory)";   memory="${memory##*: }"
disk="$(neofetch disk)";       disk="${disk##*: }"
uptime="$(neofetch uptime)";   uptime="${uptime##*: }"
bandwidth=$(vnstat --oneline | cut -d ";" -f 15)

echo "[DEBUG] Service requested: $service"
echo "[DEBUG] Server IP: $ip"

if [[ $service == "ssh" ]]; then
    ssh=$(systemctl is-active sshd)
    dropbear=$((echo >/dev/tcp/localhost/44) &>/dev/null && echo "active" || echo "inactive")
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    total_sshd=$(netstat -natp 2>/dev/null \vert{} awk "/$ip:22\y/ && /ESTABLISHED/ && /sshd/" | wc -l)
    total_dropbear=$(netstat -natp 2>/dev/null \vert{} awk "/$ip:44\y/ && /ESTABLISHED/ && /dropbear/" | wc -l)
    total_socket=$(netstat -natp 2>/dev/null \vert{} awk "/$ip:80\y/ && /ESTABLISHED/ && /python/" | wc -l)
    total_ssl=$(netstat -natp 2>/dev/null \vert{} awk "/$ip:443\y/ && /ESTABLISHED/ && /stunnel4/" | wc -l)
    totalssh=$((total_sshd + total_dropbear + total_socket + total_ssl))
    
    [ -f /root/.ports ] && . /root/.ports

    output=$(cat <<EOF
{
 "service": "ssh protocol",
 "ip": "$ip",
 "users": "$totalssh",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "ssh_port": "$ssh_port -$ssh",
 "dropbear_port": "$dropbear_port -$dropbear",
 "socket_port": "$socket_port -$socket",
 "squid_port": "$squid_port -$squid",
 "ssh_ssl_port": "$ssh_ssl_port -$ssl",
 "dropbear_ssl_port": "$dropbear_ssl_port -$ssl"
}
EOF
)
    echo "$output"

elif [[ $service == "wireguard" ]]; then
    WG_INTERFACE="wg0"
    WG_SERVICE="wg-quick@${WG_INTERFACE}"

    [ -f /root/.ports ] && . /root/.ports
    [ -f /etc/wireguard/params ] && . /etc/wireguard/params
    [ -f /root/.db-base ] && . /root/.db-base

    wireguard_status=$(systemctl is-active "$WG_SERVICE" 2>/dev/null)
    wireguard_status=${wireguard_status:-inactive}

    wireguard_port=$(wg show "$WG_INTERFACE" listen-port 2>/dev/null)
    wireguard_port=${wireguard_port:-${SERVER_PORT:-51820}}

    total_peers=0
    if command -v wg >/dev/null 2>&1 &&
       wg show "$WG_INTERFACE" peers >/dev/null 2>&1; then
        total_peers=$(wg show "$WG_INTERFACE" peers 2>/dev/null | grep -c .)
    fi

    total_wireguard=0
    current_time=$(date +%s)

    if [ "$wireguard_status" = "active" ]; then
        while read -r peer_key handshake_time; do
            [[ "$handshake_time" =~ ^[0-9]+$ ]] || continue

            if (( handshake_time > 0 &&
                  current_time - handshake_time <= 180 )); then
                total_wireguard=$((total_wireguard + 1))
            fi
        done < <(wg show "$WG_INTERFACE" latest-handshakes 2>/dev/null)
    fi

    output=$(cat <<EOF
{
 "service": "wireguard protocol",
 "ip": "$ip",
 "users": "$total_wireguard",
 "peers": "$total_peers",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "wireguard_status": "$wireguard_status",
 "wireguard_port": "$wireguard_port",
 "wireguard_interface": "$WG_INTERFACE"
}
EOF
)
    echo "$output"

    DB_USE="${DB:-$DB_NAME}"
    USER_USE="${USER:-$DB_USER}"
    PASS_USE="${PASS:-$DB_PASS}"
    HOST_USE="${HOST:-$DB_HOST}"

    if command -v mysql >/dev/null 2>&1 &&
       [ -n "$DB_USE" ] && [ -n "$USER_USE" ] &&
       [ -n "$HOST_USE" ]; then

        column_exists() {
            mysql --skip-ssl -N -s \
                -u "$USER_USE" ${PASS_USE:+-p"$PASS_USE"} \
                -D "$DB_USE" -h "$HOST_USE" \
                -e "SHOW COLUMNS FROM server_list LIKE '$1'" \
                2>/dev/null | grep -q .
        }

        sql_updates=""

        if column_exists "wireguard_status"; then
            sql_updates="${sql_updates}, wireguard_status='${wireguard_status}'"
        fi

        if column_exists "wireguard_port"; then
            sql_updates="${sql_updates}, wireguard_port='${wireguard_port}'"
        fi

        if column_exists "wireguard_online"; then
            sql_updates="${sql_updates}, wireguard_online='${total_wireguard}'"
        fi

        if column_exists "wireguard_peers"; then
            sql_updates="${sql_updates}, wireguard_peers='${total_peers}'"
        fi

        if [ -n "$sql_updates" ]; then
            sql_updates="${sql_updates#, }"

            mysql --skip-ssl \
                -u "$USER_USE" ${PASS_USE:+-p"$PASS_USE"} \
                -D "$DB_USE" -h "$HOST_USE" \
                -e "UPDATE server_list
                    SET ${sql_updates}
                    WHERE server_ip='${ip}'" 2>/dev/null

            echo "[DEBUG] WireGuard database update exit code: $?"
        else
            echo "[DEBUG] Walang matching WireGuard columns sa server_list."
        fi
    fi

elif [[ $service == "hysteria" ]]; then
    udphysteria=$(systemctl is-active hysteria-luma.service)
    udphysteria2=$(systemctl is-active hysteria-v2.service)
    squid=$(systemctl is-active squid)
    
    [ -f /root/.ports ] && . /root/.ports
    [ -f /root/.db-base ] && . /root/.db-base

    hysteria_port=${hysteria_port:-5666}
    hysteria2_port=${hysteria2_port:-5667}

    if [ "$udphysteria" = "active" ] \vert{}\vert{} [ "$udphysteria2" = "active" ]; then
        total_hysteria=1
    else
        total_hysteria=0
    fi

    output=$(cat <<EOF
{
 "service": "hysteria protocol",
 "ip": "$ip",
 "users": "$total_hysteria",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "udp_hysteria": "$hysteria_port -$udphysteria",
 "udp_hysteria2": "$hysteria2_port -$udphysteria2",
 "squid_port": "$squid_port -$squid"
}
EOF
)
    echo "$output"

    echo "[DEBUG] Running MySQL UPDATE for hysteria..."
    mysql --skip-ssl -u "$DB_USER" ${DB_PASS:+-p"$DB_PASS"} -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', hysteria_status='$udphysteria', hysteria2_status='$udphysteria2', squid_status='$squid', hysteria_port='$hysteria_port', hysteria2_port='$hysteria2_port', squid='$squid_port', online='$total_hysteria', hysteria_online='$total_hysteria' WHERE server_ip='$ip'" 2>/dev/null
    echo "[DEBUG] MySQL query exit code: $?"

elif [[ $service == "socksip" ]]; then
    udpSERVER=$(systemctl is-active UDPserver)
    squid=$(systemctl is-active squid)

    [ -f /root/.ports ] && . /root/.ports
    [ -f /root/.db-base ] && . /root/.db-base

    echo "[DEBUG] Running MySQL UPDATE for socksip..."
    mysql --skip-ssl -u "$DB_USER" ${DB_PASS:+-p"$DB_PASS"} -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', socksip_status='$udpSERVER', socksip_port='$socksip_port' WHERE server_ip='$ip'" 2>/dev/null
    echo "[DEBUG] MySQL query exit code: $?"

elif [[ $service == "openvpn" ]]; then
    tcpovpn=$(systemctl is-active openvpn@server2.service)
    udpovpn=$(systemctl is-active openvpn@server.service)
    
    udphysteria=$(systemctl is-active hysteria-luma.service)
    udphysteria2=$(systemctl is-active hysteria-v2.service)

    xray=$(systemctl is-active xray.service)
    slowdns=$(systemctl is-active server-sldns.service)
    sshd=$(systemctl is-active sshd)
    dropbear=$(systemctl is-active dropbear)
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    ovpn_users=""
    [ -f /etc/openvpn/server/tcpclient.log ] && {
        ovpn_users="$ovpn_users$(awk '/^ROUTING_TABLE/ {print $2}' /etc/openvpn/server/tcpclient.log 2>/dev/null)"
    }
    [ -f /etc/openvpn/server/udpclient.log ] && {
        ovpn_users="$ovpn_users$(awk '/^ROUTING_TABLE/ {print $2}' /etc/openvpn/server/udpclient.log 2>/dev/null)"
    }
    totalovpn=$(echo "$ovpn_users" \vert{} xargs -n1 \vert{} grep -v '^$' | sort -u | wc -l)
    
    active_
