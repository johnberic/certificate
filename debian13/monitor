elif [[ "$service" == "wireguard" ]]; then
    WG_INTERFACE="wg0"
    WG_SERVICE="wg-quick@${WG_INTERFACE}"

    # Load WireGuard settings, kung mayroon
    [ -f /root/.ports ] && . /root/.ports
    [ -f /etc/wireguard/params ] && . /etc/wireguard/params
    [ -f /root/.db-base ] && . /root/.db-base

    # WireGuard service status
    wireguard_status=$(systemctl is-active "$WG_SERVICE" 2>/dev/null)
    wireguard_status=${wireguard_status:-inactive}

    # Kunin ang aktuwal na listening port
    wireguard_port=$(wg show "$WG_INTERFACE" listen-port 2>/dev/null)
    wireguard_port=${wireguard_port:-${SERVER_PORT:-51820}}

    # Count configured peers
    total_peers=0
    if command -v wg >/dev/null 2>&1 &&
       wg show "$WG_INTERFACE" peers >/dev/null 2>&1; then
        total_peers=$(wg show "$WG_INTERFACE" peers 2>/dev/null | grep -c .)
    fi

    # Count peers na nag-handshake sa nakaraang 180 seconds
    total_wireguard=0
    current_time=$(date +%s)

    if [ "$wireguard_status" = "active" ]; then
        while read -r peer_key handshake_time; do
            [[ "$handshake_time" =~ ^[0-9]+$ ]] || continue

            if (( handshake_time > 0 &&
                  current_time - handshake_time <= 180 )); then
                total_wireguard=$((total_wireguard + 1))
            fi
        done < <(wg show "$WG_INTERFACE" latest-handshakes 2>/dev/null)
    fi

    # WireGuard JSON response
    output=$(cat <<EOF
{
 "service": "wireguard protocol",
 "ip": "$ip",
 "users": "$total_wireguard",
 "peers": "$total_peers",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "wireguard_status": "$wireguard_status",
 "wireguard_port": "$wireguard_port",
 "wireguard_interface": "$WG_INTERFACE"
}
EOF
)
    echo "$output"

    # Optional database update.
    # Tiyaking umiiral muna ang columns para maiwasan ang SQL errors.
    DB_USE="${DB:-$DB_NAME}"
    USER_USE="${USER:-$DB_USER}"
    PASS_USE="${PASS:-$DB_PASS}"
    HOST_USE="${HOST:-$DB_HOST}"

    if command -v mysql >/dev/null 2>&1 &&
       [ -n "$DB_USE" ] && [ -n "$USER_USE" ] &&
       [ -n "$HOST_USE" ]; then

        column_exists() {
            mysql --skip-ssl -N -s \
                -u "$USER_USE" -p"$PASS_USE" \
                -D "$DB_USE" -h "$HOST_USE" \
                -e "SHOW COLUMNS FROM server_list LIKE '$1'" \
                2>/dev/null | grep -q .
        }

        sql_updates=""

        if column_exists "wireguard_status"; then
            sql_updates="${sql_updates}, wireguard_status='${wireguard_status}'"
        fi

        if column_exists "wireguard_port"; then
            sql_updates="${sql_updates}, wireguard_port='${wireguard_port}'"
        fi

        if column_exists "wireguard_online"; then
            sql_updates="${sql_updates}, wireguard_online='${total_wireguard}'"
        fi

        if column_exists "wireguard_peers"; then
            sql_updates="${sql_updates}, wireguard_peers='${total_peers}'"
        fi

        if [ -n "$sql_updates" ]; then
            sql_updates="${sql_updates#, }"

            mysql --skip-ssl \
                -u "$USER_USE" -p"$PASS_USE" \
                -D "$DB_USE" -h "$HOST_USE" \
                -e "UPDATE server_list
                    SET ${sql_updates}
                    WHERE server_ip='${ip}'" 2>/dev/null

            echo "[DEBUG] WireGuard database update exit code: $?"
        else
            echo "[DEBUG] Walang matching WireGuard columns sa server_list."
        fi


elif [[ $service == "xray" ]]; then
    xray=$(systemctl is-active xray.service)
    nginx=$(systemctl is-active nginx)
    squid=$(systemctl is-active squid)

    [ -f /root/.ports ] && . /root/.ports
    [ -f /etc/xray/.db-base ] && . /etc/xray/.db-base

    x_port=${xray_port:-10001}
    total_xray=$(ss -tnp 2>/dev/null | grep 'xray' | grep ":$x_port" | grep ESTAB | awk '{print $5}' | cut -d: -f1 | sort -u | wc -l)
    XRAY_BIN=$(which xray 2>/dev/null || echo "/usr/local/bin/xray")

    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE users SET is_connected = 0, login_status = 'offline'" 2>/dev/null

