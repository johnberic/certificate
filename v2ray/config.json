  "outbounds": [
    {
      "protocol": "dns",
      "tag": "dns-out"
    },
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      },
      "streamSettings": {
        "sockopt": { "mark": 255 }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blackhole"
    },
    {
      "protocol": "socks",
      "settings": {
        "servers": [{ "port": 10000, "address": "127.0.0.1" }]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      },
      "tag": "out"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "ip": [
          "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "169.254.0.0/16",
          "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16",
          "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24",
          "::1/128", "fc00::/7", "fe80::/10"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "domain": ["geosite:category-ads-all"],
        "outboundTag": "blackhole"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private", "geosite:apple-id", "geosite:google-id",
          "geosite:tld-id", "geosite:category-games@id"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["geosite:geolocation-!id"],
        "outboundTag": "out"
      },
      {
        "type": "field",
        "domain": ["geosite:id"],
        "outboundTag": "direct"
      }
