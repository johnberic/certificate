      "port": "10002",
      "protocol": "vmess",
      "settings": {
        "clients": [{ "id": "DexterEskalarte", "alterId": 0 }]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "/vmess" }
