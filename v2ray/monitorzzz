elif [[ $service == "xray" ]]; then
    xray=$(systemctl is-active xray.service)
    nginx=$(systemctl is-active nginx)
    squid=$(systemctl is-active squid)

    . /root/.ports
    . /etc/xray/.db-base

    x_port=${xray_port:-10001}
    total_xray=$(ss -tnp | grep 'xray' | grep ":$x_port" | grep ESTAB | awk '{print $5}' | cut -d: -f1 | sort -u | wc -l)

    # 1. I-reset muna silang lahat sa offline (0) sa simula
    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE users SET is_connected = 0, login_status = 'offline'" 2>/dev/null
    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "DELETE FROM xray_online WHERE server_ip='$ip'" 2>/dev/null

    log_file="/var/log/xray/access.log"
    if [ -f "$log_file" ] && [ "$total_xray" -gt 0 ]; then
        # Kunin ang mga active users at ang kanilang IP address mula sa log
        # Naghahanap tayo ng linya na may 'accepted' at kumukuha ng IP at email
        recent_logs=$(tail -n 300 "$log_file" | grep -E "accepted")
        
        active_users=$(echo "$recent_logs" | grep -oE 'email: [^[:space:]]+' | awk '{print $2}' | tr -d '"'\'' ' | sort -u)
        
        if [ -n "$active_users" ]; then
            for user in $active_users; do
                if [ -n "$user" ] && [ "$user" != "-" ]; then
                    # Kunin ang huling IP address ng user na ito mula sa log
                    user_ip=$(echo "$recent_logs" | grep "email: $user" | tail -n 1 | grep -oE 'from [0-9.]+' | awk '{print $2}')
                    user_ip=${user_ip:-$ip}

                    # 2. Kunin ang upload at downlink bytes gamit ang Xray API Stats
                    up_bytes=$(xray api statsquery --server=127.0.0.1:10000 -name "user>>>$user>>>traffic>>>uplink" 2>/dev/null | grep -o '"value": [0-9]*' | awk '{print $2}')
                    down_bytes=$(xray api statsquery --server=127.0.0.1:10000 -name "user>>>$user>>>traffic>>>downlink" 2>/dev/null | grep -o '"value": [0-9]*' | awk '{print $2}')
                    
                    up_bytes=${up_bytes:-0}
                    down_bytes=${down_bytes:-0}
                    
                    current_time=$(date '+%Y-%m-%d %H:%M:%S')
                    current_ts=$(date +%s)

                    # 3. I-insert ang buong detalye sa xray_online table batay sa ibinigay mong structure
                    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "INSERT INTO xray_online (server, server_ip, server_port, since_connected, username, ipaddress, bytes_received, bytes_sent, bandwidth, time, time_in, time_out, status, timestamp, category) VALUES ('Xray', '$ip', '$x_port', '$current_time', '$user', '$user_ip', '$down_bytes', '$up_bytes', 0, '$current_time', '$current_time', '$current_time', 'online', '$current_ts', 'premium') ON DUPLICATE KEY UPDATE bytes_received='$down_bytes', bytes_sent='$up_bytes', status='online', time='$current_time'" 2>/dev/null
                    
                    # 4. I-update ang users table para sa is_connected at total usage
                    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE users SET is_connected = 1, login_status = 'online', xray_upload = xray_upload + $up_bytes, xray_download = xray_download + $down_bytes WHERE user_name = '$user'" 2>/dev/null
                fi
            done
        fi
    fi

    # 5. I-update ang server status list
    mysql -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', xray_tls='$xray_tls', xray_ntls='$xray_ntls', xray_status='$xray', squid_status='$squid', squid='$squid_port', xray_vmess='$vmess', xray_vless='$vless', xray_trojan='$trojan', xray_ss='$ss', xray_online='$total_xray' WHERE server_ip='$ip'"
fi
