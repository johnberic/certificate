#!/bin/bash
service=$1
ip=$(curl -s https://api.ipify.org)
os="$(neofetch os)";         os="${os##*: }"
distro="$(neofetch distro)";   distro="${distro##*: }"
cpu="$(neofetch cpu --cpu_speed on --cpu_cores off)"; cpu="${cpu##*: }"
memory="$(neofetch memory)";   memory="${memory##*: }"
disk="$(neofetch disk)";       disk="${disk##*: }"
uptime="$(neofetch uptime)";   uptime="${uptime##*: }"
bandwidth=$(vnstat --oneline | cut -d ";" -f 15)

if [[ $service == "ssh" ]]; then
    ssh=$(systemctl is-active sshd)
    dropbear=$((echo >/dev/tcp/localhost/44) &>/dev/null && echo "active" || echo "inactive")
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    total_sshd=$(netstat -natp 2>/dev/null | awk "/$ip:22\y/ && /ESTABLISHED/ && /sshd/" | wc -l)
    total_dropbear=$(netstat -natp 2>/dev/null | awk "/$ip:44\y/ && /ESTABLISHED/ && /dropbear/" | wc -l)
    total_socket=$(netstat -natp 2>/dev/null | awk "/$ip:80\y/ && /ESTABLISHED/ && /python/" | wc -l)
    total_ssl=$(netstat -natp 2>/dev/null | awk "/$ip:443\y/ && /ESTABLISHED/ && /stunnel4/" | wc -l)
    totalssh=$((total_sshd + total_dropbear + total_socket + total_ssl))
    
    [ -f /root/.ports ] && . /root/.ports

    output=$(cat <<EOF
{
 "service": "ssh protocol",
 "ip": "$ip",
 "users": "$totalssh",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "ssh_port": "$ssh_port - $ssh",
 "dropbear_port": "$dropbear_port - $dropbear",
 "socket_port": "$socket_port - $socket",
 "squid_port": "$squid_port - $squid",
 "ssh_ssl_port": "$ssh_ssl_port - $ssl",
 "dropbear_ssl_port": "$dropbear_ssl_port - $ssl"
}
EOF
)
    echo "$output"

elif [[ $service == "hysteria" ]]; then
    udphysteria=$(systemctl is-active hysteria-server.service)
    squid=$(systemctl is-active squid)
    
    [ -f /root/.ports ] && . /root/.ports
    [ -f /root/.db-base ] && . /root/.db-base

    if [ "$udphysteria" = "active" ]; then
        total_hysteria=1
    else
        total_hysteria=0
    fi

    output=$(cat <<EOF
{
 "service": "openvpn protocol",
 "ip": "$ip",
 "users": "$total_hysteria",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "udp_hysteria": "$hysteria_port - $udphysteria",
 "squid_port": "$squid_port - $squid"
}
EOF
)

    mysql -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', hysteria_status='$udphysteria', squid_status='$squid', hysteria_port='$hysteria_port', squid='$squid_port', online='$total_hysteria', hysteria_online='$total_hysteria' WHERE server_ip='$ip'"

elif [[ $service == "socksip" ]]; then
    udpSERVER=$(systemctl is-active UDPserver)
    squid=$(systemctl is-active squid)

    [ -f /root/.ports ] && . /root/.ports
    [ -f /root/.db-base ] && . /root/.db-base

    mysql -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', socksip_status='$udpSERVER', socksip_port='$socksip_port' WHERE server_ip='$ip'"

elif [[ $service == "openvpn" ]]; then
    tcpovpn=$(systemctl is-active openvpn@server2.service)
    udpovpn=$(systemctl is-active openvpn@server.service)
    udphysteria=$(systemctl is-active hysteria-server.service)
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    tcpusers=$(sed -n -e '/^ROUTING_TABLE/p' /etc/openvpn/server/tcpclient.log 2>/dev/null | wc -l)
    udpusers=$(sed -n -e '/^ROUTING_TABLE/p' /etc/openvpn/server/udpclient.log 2>/dev/null | wc -l)
    totalovpn=$((tcpusers + udpusers))
    
    [ -f /root/.ports ] && . /root/.ports
    if [ "$udphysteria" = "active" ]; then
        total_hysteria=1
    else
        total_hysteria=0
    fi
    
    [ -f /etc/openvpn/login/config.sh ] && . /etc/openvpn/login/config.sh

    output=$(cat <<EOF
{
 "service": "openvpn protocol",
 "ip": "$ip",
 "users": "$totalovpn",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "udp_hysteria": "$hysteria_port - $udphysteria",
 "tcp_port": "$tcp_port - $tcpovpn",
 "udp_port": "$udp_port - $udpovpn",
 "socket_port": "$socket_port - $socket",
 "squid_port": "$squid_port - $squid",
 "tcp_ssl_port": "$tcp_ssl_port - $ssl",
 "udp_ssl_port": "$udp_ssl_port - $ssl"
}
EOF
)

    mysql -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', tcpssl='$tcp_ssl_port', udpssl='$udp_ssl_port', tcp_status='$tcpovpn', hysteria_status='$udphysteria', udp_status='$udpovpn', ssl_status='$ssl', squid_status='$squid', socket_status='$socket', tcp='$tcp_port', udp='$udp_port', hysteria_port='$hysteria_port', squid='$squid_port', socket_port='$socket_port', online='$totalovpn', hysteria_online='$total_hysteria' WHERE server_ip='$ip'"

elif [[ $service == "aio" ]]; then
    tcpovpn=$(systemctl is-active openvpn@server2.service)
    udpovpn=$(systemctl is-active openvpn@server.service)
    udphysteria=$(systemctl is-active hysteria-server.service)
    xray=$(systemctl is-active xray.service)
    slowdns=$(systemctl is-active server-sldns.service)
    sshd=$(systemctl is-active sshd)
    dropbear=$(systemctl is-active dropbear)
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    tcpusers=$(sed -n -e '/^ROUTING_TABLE/p' /etc/openvpn/server/tcpclient.log 2>/dev/null | wc -l)
    udpusers=$(sed -n -e '/^ROUTING_TABLE/p' /etc/openvpn/server/udpclient.log 2>/dev/null | wc -l)
    totalovpn=$((tcpusers + udpusers))
    
    total_sshd=$(netstat -natp 2>/dev/null | awk "/$ip:22/ && /ESTABLISHED/ && /sshd/" | wc -l)
    total_dropbear=$(netstat -natp 2>/dev/null | awk "/$ip:441/ && /ESTABLISHED/ && /dropbear/" | wc -l)
    total_socket1=$(netstat -natp 2>/dev/null | awk "/$ip:8000/ && /ESTABLISHED/ && /python/" | wc -l)
    total_socket2=$(netstat -natp 2>/dev/null | awk "/$ip:8001/ && /ESTABLISHED/ && /python/" | wc -l)
    total_socket3=$(netstat -natp 2>/dev/null | awk "/$ip:8002/ && /ESTABLISHED/ && /python/" | wc -l)
    total_sshssl=$(netstat -natp 2>/dev/null | awk "/$ip:445/ && /ESTABLISHED/ && /stunnel4/" | wc -l)
    totalssh=$((total_sshd + total_dropbear + total_socket1 + total_socket2 + total_socket3 + total_sshssl))
    
    [ -f /root/.ports ] && . /root/.ports
    if [ "$udphysteria" = "active" ]; then
        total_hysteria=1
    else
        total_hysteria=0
    fi
    
    [ -f /etc/openvpn/login/config.sh ] && . /etc/openvpn/login/config.sh

    mysql -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', tcpssl='$tcp_ssl_port', udpssl='$udp_ssl_port', tcp_status='$tcpovpn', hysteria_status='$udphysteria', xray_status='$xray', ssh_online='$totalssh', slowdns_status='$slowdns', ssh_status='$sshd', dropbear_status='$dropbear', udp_status='$udpovpn', ssl_status='$ssl', squid_status='$squid', socket_status='$socket', tcp='$tcp_port', udp='$udp_port', hysteria_port='$hysteria_port', xray_port='$xray_port', slowdns_port='$slowdns_port', ssh_port='$ssh_port', dropbear_port='$dropbear_port', squid='$squid_port', socket_port='$socket_port', online='$totalovpn', hysteria_online='$total_hysteria' WHERE server_ip='$ip'"

elif [[ $service == "openconnect" ]]; then
    ocserv=$(systemctl is-active ocserv)
    udphysteria=$(systemctl is-active hysteria-server.service)
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    [ -f /root/.ports ] && . /root/.ports
    [ -f /root/.db-base ] && . /root/.db-base

    totalocserv=0
    
    # I-reset muna ang status ng mga connected users sa database bago mag-log ulit
    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE bandwidth_logs SET status='offline' WHERE server='OpenConnect' AND server_ip='$ip'" 2>/dev/null

    if [ "$ocserv" = "active" ]; then
        # Subukan kunin ang aktibong user data gamit ang occtl json output
        if command -v occtl &>/dev/null; then
            ocserv_json=$(occtl -j show users 2>/dev/null)
            totalocserv=$(echo "$ocserv_json" | grep -o '"Username"' | wc -l)
            
            if [ "$totalocserv" -gt 0 ] && command -v python3 &>/dev/null; then
                # Gamitin ang python para i-parse ang JSON ng occtl para diretsong makuha ang bytes at username
                python3 - "$ocserv_json" "$ip" "$DB_USER" "$DB_PASS" "$DB_NAME" "$DB_HOST" << 'EOF'
import sys
import json
import subprocess

try:
    data = json.loads(sys.argv[1])
    server_ip = sys.argv[2]
    db_user = sys.argv[3]
    db_pass = sys.argv[4]
    db_name = sys.argv[5]
    db_host = sys.argv[6]

    users_list = data if isinstance(data, list) else data.get('users', [])
    
    for u in users_list:
        username = u.get('Username', 'unknown')
        remote_ip = u.get('Remote IP', server_ip)
        rx_bytes = int(u.get('Bytes Received', 0))
        tx_bytes = int(u.get('Bytes Sent', 0))
        total_bw = rx_bytes + tx_bytes
        
        import datetime
        current_time = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        current_ts = int(datetime.datetime.now().timestamp())
        
        sql = f"""
        INSERT INTO bandwidth_logs (server, server_ip, server_port, since_connected, username, ipaddress, bytes_received, bytes_sent, bandwidth, time, time_in, time_out, status, timestamp, category) 
        VALUES ('OpenConnect', '{server_ip}', '443', '{current_time}', '{username}', '{remote_ip}', {rx_bytes}, {tx_bytes}, {total_bw}, '{current_time}', '{current_time}', '{current_time}', 'online', {current_ts}, 'premium') 
        ON DUPLICATE KEY UPDATE bytes_received = {rx_bytes}, bytes_sent = {tx_bytes}, bandwidth = {total_bw}, time='{current_time}', status='online';
        """
        
        cmd = ["mysql", "--skip-ssl", "-u", db_user, "-p" + db_pass, "-D", db_name, "-h", db_host, "-e", sql]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception as e:
    pass
EOF
            fi
        fi
        
        # Fallback kung walang occtl o walang JSON output
        if [ "$totalocserv" -eq 0 ]; then
            totalocserv=$(netstat -anp 2>/dev/null | grep -i "ocserv-main" | grep "ESTABLISHED" | wc -l)
            if [ "$totalocserv" -eq 0 ]; then
                totalocserv=$(ss -tuapn 2>/dev/null | grep -i "ocserv" | grep "ESTAB" | wc -l)
            fi
        fi
    fi

    [[ "$totalocserv" =~ ^[0-9]+$ ]] || totalocserv=0

    output=$(cat <<EOF
{
 "service": "openconnect protocol",
 "ip": "$ip",
 "users": "$totalocserv",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "udp_hysteria": "$hysteria_port - $udphysteria",
 "tcp_port": "$tcp_port - $ocserv",
 "socket_port": "$socket_port - $socket",
 "squid_port": "$squid_port - $squid",
 "tcp_ssl_port": "$tcp_ssl_port - $ssl",
 "udp_ssl_port": "$udp_ssl_port - $ssl"
}
EOF
)
    echo "$output"

    mysql -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', tcpssl='$tcp_ssl_port', udpssl='$udp_ssl_port', tcp_status='$ocserv', hysteria_status='$udphysteria', udp_status='$ocserv', ssl_status='$ssl', squid_status='$squid', socket_status='$socket', tcp='$tcp_port', udp='$udp_port', hysteria_port='$hysteria_port', squid='$squid_port', online='$totalocserv', hysteria_online='$totalocserv' WHERE server_ip='$ip'"

elif [[ $service == "xray" ]]; then
    xray=$(systemctl is-active xray.service)
    nginx=$(systemctl is-active nginx)
    squid=$(systemctl is-active squid)

    [ -f /root/.ports ] && . /root/.ports
    [ -f /etc/xray/.db-base ] && . /etc/xray/.db-base

    x_port=${xray_port:-10001}
    total_xray=$(ss -tnp 2>/dev/null | grep 'xray' | grep ":$x_port" | grep ESTAB | awk '{print $5}' | cut -d: -f1 | sort -u | wc -l)
    XRAY_BIN=$(which xray 2>/dev/null || echo "/usr/local/bin/xray")

    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE users SET is_connected = 0, login_status = 'offline'" 2>/dev/null

    log_file="/var/log/xray/access.log"
    if [ -f "$log_file" ] && [ "$total_xray" -gt 0 ]; then
        recent_logs=$(tail -n 300 "$log_file" | grep -E "accepted")
        active_users=$(echo "$recent_logs" | grep -oE 'email: [^[:space:]]+' | awk '{print $2}' | tr -d '"'\'' ' | sort -u)
        
        if [ -n "$active_users" ]; then
            all_stats=$($XRAY_BIN api statsquery --server=127.0.0.1:10000 -pattern "" -reset=false 2>/dev/null)

            for user in $active_users; do
                if [ -n "$user" ] && [ "$user" != "-" ]; then
                    user_ip=$(echo "$recent_logs" | grep "email: $user" | tail -n 1 | grep -oE 'from [0-9.]+' | awk '{print $2}')
                    user_ip=${user_ip:-$ip}

                    current_up=$(echo "$all_stats" | grep -F "user>>>$user>>>traffic>>>uplink" -A 1 | grep '"value":' | head -n 1 | grep -o '[0-9]*')
                    current_down=$(echo "$all_stats" | grep -F "user>>>$user>>>traffic>>>downlink" -A 1 | grep '"value":' | head -n 1 | grep -o '[0-9]*')
                    
                    current_up=${current_up:-0}
                    current_down=${current_down:-0}
                    
                    [[ "$current_up" =~ ^[0-9]+$ ]] || current_up=0
                    [[ "$current_down" =~ ^[0-9]+$ ]] || current_down=0

                    total_cycle_bandwidth=$((current_up + current_down))
                    current_time=$(date '+%Y-%m-%d %H:%M:%S')
                    current_ts=$(date +%s)

                    sql_insert="INSERT INTO bandwidth_logs (server, server_ip, server_port, since_connected, username, ipaddress, bytes_received, bytes_sent, bandwidth, time, time_in, time_out, status, timestamp, category) VALUES ('Xray', '$ip', '$x_port', '$current_time', '$user', '$user_ip', '$current_down', '$current_up', '$total_cycle_bandwidth', '$current_time', '$current_time', '$current_time', 'online', '$current_ts', 'premium') ON DUPLICATE KEY UPDATE bytes_received = bytes_received + $current_down, bytes_sent = bytes_sent + $current_up, bandwidth = bandwidth + $total_cycle_bandwidth, time='$current_time', status='online';"
                    
                    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "$sql_insert" 2>/dev/null
                    mysql --skip-ssl -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE users SET is_connected = 1, login_status = 'online', xray_upload = xray_upload + $current_up, xray_download = xray_download + $current_down WHERE user_name = '$user'" 2>/dev/null
                fi
            done
        fi
    fi

    mysql -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', xray_tls='$xray_tls', xray_ntls='$xray_ntls', xray_status='$xray', squid_status='$squid', squid='$squid_port', xray_vmess='$vmess', xray_vless='$vless', xray_trojan='$trojan', xray_ss='$ss', xray_online='$total_xray' WHERE server_ip='$ip'" 2>/dev/null

elif [[ $service == "pptp" ]]; then
    pptpd=$(systemctl is-active pptpd)

    output=$(cat <<EOF
{
 "service": "pptp protocol",
 "ip": "$ip",
 "bandwidth": "$bandwidth",
 "pptpd": "$pptpd",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime"
}
EOF
)
    echo "$output"

elif [[ $service == "reboot" ]]; then
    sudo shutdown -r now
fi
