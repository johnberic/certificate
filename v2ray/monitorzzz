elif [[ $service == "xray" ]]; then
    xray=$(systemctl is-active xray.service)
    nginx=$(systemctl is-active nginx)
    squid=$(systemctl is-active squid)

    . /root/.ports
    . /etc/xray/.db-base

    x_port=${xray_port:-10001}
    total_xray=$(netstat -natp | grep xray | grep ":$x_port" | grep ESTABLISHED | awk '{print $4}' | cut -d: -f2 | sort -u | wc -l)

    # 1. I-reset muna silang lahat sa offline (0) sa simula
    mysql --skip-ssl -u $DB_USER -p$DB_PASS -D $DB_NAME -h $DB_HOST -e "UPDATE users SET is_connected = 0, login_status = 'offline'" 2>/dev/null
    mysql --skip-ssl -u $DB_USER -p$DB_PASS -D $DB_NAME -h $DB_HOST -e "DELETE FROM xray_online WHERE server_ip='$ip'" 2>/dev/null
    
    log_file="/var/log/xray/access.log"
    if [ -f "$log_file" ]; then
        active_users=$(tail -n 500 "$log_file" | grep "accepted" | awk -F'email: ' '{print $2}' | awk '{print $1}' | sort -u)
        
        if [ -n "$active_users" ]; then
            tmp_users="/tmp/xray_active_users.txt"
            > "$tmp_users"
            
            for user in $active_users; do
                if [ -n "$user" ] && [ "$user" != "-" ]; then
                    echo "('$user', '$ip')" >> "$tmp_users"
                fi
            done
            
            if [ -s "$tmp_users" ]; then
                # 2. I-insert ang mga active users sa xray_online table
                values_str=$(paste -sd, "$tmp_users")
                mysql --skip-ssl -u $DB_USER -p$DB_PASS -D $DB_NAME -h $DB_HOST -e "INSERT IGNORE INTO xray_online (username, server_ip) VALUES $values_str" 2>/dev/null
                
                # 3. Kunin ang eksaktong mga username na nai-save sa xray_online para sabay silang maging online (1)
                users_list=$(awk -F"'" '{print "'\''" $2 "'\''"}' "$tmp_users" | paste -sd,)
                if [ -n "$users_list" ]; then
                    mysql --skip-ssl -u $DB_USER -p$DB_PASS -D $DB_NAME -h $DB_HOST -e "UPDATE users SET is_connected = 1, login_status = 'online' WHERE user_name IN ($users_list)" 2>/dev/null
                fi
            fi
            
            rm -f "$tmp_users"
        fi
    fi

    # 4. I-update ang server status kasama ang kabuuang total ng xray online
    mysql -u $DB_USER -p$DB_PASS -D $DB_NAME -h $DB_HOST -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', xray_tls='$xray_tls', xray_ntls='$xray_ntls', xray_status='$xray', squid_status='$squid', squid='$squid_port', xray_vmess='$vmess', xray_vless='$vless', xray_trojan='$trojan', xray_ss='$ss', xray_online='$total_xray' WHERE server_ip='$ip'"
