elif [[ $service == "openconnect" ]]; then
    ocserv=$(systemctl is-active ocserv)
    udphysteria=$(systemctl is-active hysteria-server.service)
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")
    
    [ -f /root/.ports ] && . /root/.ports
    [ -f /root/.db-base ] && . /root/.db-base

    totalocserv=0
    if [ "$ocserv" = "active" ]; then
        if command -v occtl &>/dev/null; then
            # Gamitin ang JSON format para sigurado at walang sablay sa pagbasa ng bytes
            json_users=$(occtl -j show users 2>/dev/null)
            totalocserv=$(echo "$json_users" | grep -o '"username"' | wc -l)
            
            if [ "$totalocserv" -gt 0 ] && command -v python3 &>/dev/null; then
                # I-parse ang JSON gamit ang python3 para makuha ang username, ip, rx, at tx
                python3 - "$json_users" "$ip" "$DB_USER" "$DB_PASS" "$DB_NAME" "$DB_HOST" << 'EOF'
import sys
import json
import subprocess

try:
    data = json.loads(sys.argv[1])
    server_ip = sys.argv[2]
    db_user = sys.argv[3]
    db_pass = sys.argv[4]
    db_name = sys.argv[5]
    db_host = sys.argv[6]

    users_list = data if isinstance(data, list) else data.get('users', [])

    for u in users_list:
        username = u.get('username')
        remote_ip = u.get('ip') or u.get('remote-ip', server_ip)
        rx_bytes = int(u.get('rx-bytes', 0))
        tx_bytes = int(u.get('tx-bytes', 0))
        total_bw = rx_bytes + tx_bytes

        if not username:
            continue

        sql = f"""
        INSERT INTO bandwidth_logs 
        (server, server_ip, server_port, since_connected, username, ipaddress, bytes_received, bytes_sent, bandwidth, time, time_in, time_out, status, timestamp, category) 
        VALUES ('OpenConnect', '{server_ip}', '443', NOW(), '{username}', '{remote_ip}', '{rx_bytes}', '{tx_bytes}', '{total_bw}', NOW(), NOW(), NOW(), 'online', UNIX_TIMESTAMP(), 'premium') 
        ON DUPLICATE KEY UPDATE 
        bytes_received = '{rx_bytes}', bytes_sent = '{tx_bytes}', bandwidth = '{total_bw}', time = NOW(), status = 'online';
        """

        cmd = ["mysql", "--skip-ssl", "-u", db_user, f"-p{db_pass}", "-D", db_name, "-h", db_host, "-e", sql]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception as e:
    pass
EOF
            fi
        fi
        
        if [ "$totalocserv" -eq 0 ]; then
            totalocserv=$(netstat -anp 2>/dev/null | grep -i "ocserv-main" | grep "ESTABLISHED" | wc -l)
            if [ "$totalocserv" -eq 0 ]; then
                totalocserv=$(ss -tuapn 2>/dev/null | grep -i "ocserv" | grep "ESTAB" | wc -l)
            fi
        fi
    fi

    [[ "$totalocserv" =~ ^[0-9]+$ ]] || totalocserv=0

    output=$(cat <<EOF
{
 "service": "openconnect protocol",
 "ip": "$ip",
 "users": "$totalocserv",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime",
 "udp_hysteria": "$hysteria_port - $udphysteria",
 "tcp_port": "$tcp_port - $ocserv",
 "socket_port": "$socket_port - $socket",
 "squid_port": "$squid_port - $squid",
 "tcp_ssl_port": "$tcp_ssl_port - $ssl",
 "udp_ssl_port": "$udp_ssl_port - $ssl"
}
EOF
)
    echo "$output"

    mysql -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -h "$DB_HOST" -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', tcpssl='$tcp_ssl_port', udpssl='$udp_ssl_port', tcp_status='$ocserv', hysteria_status='$udphysteria', udp_status='$ocserv', ssl_status='$ssl', squid_status='$squid', socket_status='$socket', tcp='$tcp_port', udp='$udp_port', hysteria_port='$hysteria_port', squid='$squid_port', online='$totalocserv', hysteria_online='$totalocserv' WHERE server_ip='$ip'"
